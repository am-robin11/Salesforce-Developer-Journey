    <label>Target Currency</label>
    <type>Text</type>
    <length>10</length>
    <description>USD, EUR, JPY, etc.</description>
</CustomField>

<!-- fields/Exchange_Rate__c.field-meta.xml -->
<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
