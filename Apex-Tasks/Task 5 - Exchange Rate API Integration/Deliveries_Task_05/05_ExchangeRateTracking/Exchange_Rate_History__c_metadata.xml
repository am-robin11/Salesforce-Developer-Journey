<!-- Exchange_Rate_History__c/Exchange_Rate_History__c.object-meta.xml -->
<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Exchange Rate History</label>
    <pluralLabel>Exchange Rate Histories</pluralLabel>
    <nameField>
        <type>AutoNumber</type>
        <label>Exchange Rate History Name</label>
        <displayFormat>ERH-{0000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>

<!-- fields/Base_Currency__c.field-meta.xml -->
